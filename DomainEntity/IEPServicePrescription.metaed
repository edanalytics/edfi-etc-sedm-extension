Domain Entity IEPServicePrescription
    documentation "The service prescribed to a student as part of their IEP."
    association StudentIEPAssociation
        documentation "The student IEP for which the service is prescribed."
        is part of identity
    descriptor ServicePrescription
        documentation "The type of service prescribed. Examples include: Auditory Specialist, Vocational Therapy."
        is part of identity
    date ServicePrescriptionDate
        documentation "The date the service was prescribed."
        is part of identity
    date BeginDate 
        documentation "The effective date when service is to begin."
        is required
    date EndDate 
        documentation "The effective date when the prescribed service ended."
        is optional
    domain entity IDEAEvent
        documentation "The IDEA event related to the prescribed service."
        is optional
        merge IDEAEvent.Student.StudentUniqueId with StudentIEPAssociation.Student.StudentUniqueId
    double DurationMinutes
        documentation "The length of time for the prescribed service in minutes."
        is required
    descriptor DurationPeriod
        documentation "The frequency period for the prescribed service duration. Examples include: Per Session, Per Week, Per Month."
        is required
    double FrequencyValue
        documentation "The number of times the prescribed service is to be provided within the specified duration period."
        is required
    descriptor FrequencyPeriod
        documentation "The frequency period for the prescribed service. Examples include: Session, Week, Month."
        is required     
    descriptor ServiceLocationType
        documentation "The location type where the prescribed service is to be provided. Examples include: Home, Hospital, School."
        is required
    domain entity EdFi.EducationOrganization
        documentation "The identifier assigned to the education organization (usually District/LEA) providing prescribed services."
        role name ServiceProviding
        is optional
    domain entity EdFi.Staff
        documentation "A reference to the staff member providing the prescribed service."
        is optional